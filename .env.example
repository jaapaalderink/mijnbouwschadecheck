# Gebruik eigen waarden. Dit bestand bevat geen echte secrets.
DATABASE_URL=postgresql://mijnbouw:CHANGE_ME@127.0.0.1:5432/mijnbouw
# Voor MariaDB: mysql://GEBRUIKER:URL_ENCODED_WACHTWOORD@localhost:3306/DATABASE
# Gebruik volledige gebruikers- en databasenamen uit DirectAdmin, inclusief prefix.
DATABASE_SSL=false
SITE_URL=http://localhost:3001
PORT=3001
NODE_ENV=development
# Zet alleen op 1 achter precies één vertrouwde reverse proxy.
TRUST_PROXY=0
COMPANY_NAME=Mijnbouwschadecheck
COMPANY_DETAILS=
CONTACT_EMAIL=
CONTACT_PHONE=
PRIVACY_CONTACT=
PRIVACY_LEGAL_BASIS=
PRIVACY_PROCESSORS=
PRIVACY_APPROVED=false
# Niet invullen voordat de bewaartermijn is vastgesteld. Job is handmatig.
RETENTION_DAYS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
NOTIFICATION_EMAIL=
# Alleen tijdelijk voor admin:create, niet voor de normale applicatie.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optioneel: base32 TOTP-secret, handmatig veilig in authenticator instellen.
ADMIN_TOTP_SECRET=
